(sort wff provable)
(sort nat)
(term wi ((a wff ()) (b wff ())) (wff ()))
(term tru () (wff ()))
(term eq ((a nat ()) (b nat ())) (wff ()))
(axiom ax1 ((a wff ()) (b wff ())) () (wi a (wi b a)))
(axiom truth () () (tru))
(def foo ((a nat ())) (wff ()) () (eq a a))
(theorem bad ((y nat)) () (foo y) () (:conv (foo y) (:unfold foo (y) () (tru)) (truth ())))
