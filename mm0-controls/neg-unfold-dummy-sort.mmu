(sort wff provable)
(sort nat)
(term wi ((a wff ()) (b wff ())) (wff ()))
(term al ((x nat) (a wff (x))) (wff ()))
(term z () (nat ()))
(term eq ((a nat ()) (b nat ())) (wff ()))
(axiom ax1 ((a wff ()) (b wff ())) () (wi a (wi b a)))
(axiom mp ((a wff ()) (b wff ())) ((wi a b) a) b)
(axiom ax5 ((x nat) (a wff ())) () (wi a (al x a)))
(axiom ax6 ((x nat) (y nat)) () (wi (eq x y) (eq y x)))
(axiom axbx ((x nat) (a wff ())) () (wi a (eq x x)))
(axiom refl ((a nat ())) () (eq a a))
(def ex2 () (wff ()) ((y nat)) (al y (eq y y)))
(axiom exax2 () () (ex2))
(theorem bad ((p wff)) () (al p (eq p p)) () (:conv (al p (eq p p)) (:unfold ex2 () (p) (al p (eq p p))) (exax2 ())))
