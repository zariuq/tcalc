(sort wff provable)
(sort nat)
(term wi ((a wff ()) (b wff ())) (wff ()))
(term tru () (wff ()))
(term eq ((a nat ()) (b nat ())) (wff ()))
(axiom ax1 ((a wff ()) (b wff ())) () (wi a (wi b a)))
(axiom truth () () (tru))
(def foo ((a nat ())) (wff ()) () (eq a a))
(axiom refl_eq ((a nat ())) () (eq a a))
(theorem good ((y nat)) () (foo y) () (:conv (foo y) (:unfold foo (y) () (eq y y)) (refl_eq (y))))
