delimiter $ ( ~ $ $ ) , $;
strict provable sort wff;
sort nat;
term im (a b: wff): wff; infixr im: $->$ prec 25;
term neg (a: wff): wff; prefix neg: $~$ prec 40;
term al {x: nat} (a: wff x): wff;
notation al {x: nat} (a: wff x): wff = ($A.$:30) x ($,$:30) a;
term z: nat;
term eq (a b: nat): wff; infixl eq: $=$ prec 50;
def an (a b: wff): wff = $ ~(a -> ~b) $;
infixl an: $/\$ prec 20;
def ex {x: nat} (a: wff x): wff = $ ~(A. x, ~a) $;
def tru (.y: nat): wff = $ A. y, y = y $;
def abs (a: wff): wff;
axiom mp (a b: wff): $ a -> b $ > $ a $ > $ a $ > $ b $;
axiom ax1 (a b: wff): $ a -> b -> a $;
axiom gen {x: nat} (a: wff x): $ a $ > $ A. x, a $;
axiom ax_eq {x: nat}: $ x = x $;
theorem a1i (a b: wff): $ a $ > $ b -> a $;
theorem gen2 {x: nat} (a: wff x) (b: wff): $ a $ > $ b $ > $ A. x, a $;
theorem eqx {y: nat}: $ y = y $;
