; Compare two unsigned words under the low three bits of a relation mask.
; Bits 1, 2 and 4 allow less, equal and greater respectively. A matching
; guard returns arg0; a refusal returns zero. The fuel receipt is unchanged.

!(import! &self "../../p1/p1.metta")

(= (relw:program)
   (p1:program relw
     (Regions)
     (Registers (As mask v1) (As a v2) (As b v3)
                (As cmp v4) (As bit v5) (As allowed v6))
     (Init (Entry mask TyU64))
     (Seq (Arg0 a) (Arg1 b)
          (Cmp Ult cmp a b)
          (If cmp (Imm bit 1)
              (Seq (Cmp Eq cmp a b) (If cmp (Imm bit 2) (Imm bit 4))))
          (And allowed mask bit)
          (CmpI Ne cmp allowed 0)
          (If cmp (Return FIRED a))
          (Return REFUSED cmp))))

!(let* (($text-path (system:arg 0)) ($notes-path (system:arg 1)) ($proof-path (system:arg 2))
        ($program (p1:the-program relw:program))
        ($text (p1:write-text $program $text-path))
        ($notes (p1:write-notes $program $notes-path))
        ($proof (fs:write $proof-path
          (p1:cat ("(* Generated by relw.metta. *)\nlet RELW_TERM = new_definition\n `relw = "
                   (p1:hol-text $program) "`;;\n")))))
   (Wrote $text-path $notes-path $proof-path))
