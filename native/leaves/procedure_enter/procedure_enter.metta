; Enter one bounded procedure activation.
; Arg0 is the current depth, arg1 the frame capacity. A full stack returns
; UNSUPPORTED without charging fuel. Otherwise FUND 1 charges the activation
; or returns EXHAUSTED. FIRED returns the next depth. No regions are written.

!(import! &self "../../p1/p1.metta")

(= (procedure_enter:program)
   (p1:program procedure_enter
     (Regions)
     (Registers (As depth v1) (As capacity v2) (As room v3) (As next v4))
     (Init)
     (Seq (Arg0 depth) (Arg1 capacity)
          (Cmp Ult room depth capacity)
          (If room
            (Seq (TFund 1) (Imm next 1) (Add next depth next)
                 (Return FIRED next)))
          (Return UNSUPPORTED room))))

!(let* (($text-path (system:arg 0)) ($notes-path (system:arg 1)) ($proof-path (system:arg 2))
        ($program (p1:the-program procedure_enter:program))
        ($text (p1:write-text $program $text-path))
        ($notes (p1:write-notes $program $notes-path))
        ($proof (fs:write $proof-path
          (p1:cat ("(* Generated by procedure_enter.metta. *)\nlet PROCEDURE_ENTER_TERM = new_definition\n `procedure_enter = "
                   (p1:hol-text $program) "`;;\n")))))
   (Wrote $text-path $notes-path $proof-path))
