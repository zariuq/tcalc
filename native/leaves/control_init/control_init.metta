; Initialize the checker's first 24 control words before bootstrap.
; Region 0 is writable, with at least 192 aligned bytes. Arg0 is the host
; policy 0..2. Other policies return REFUSED before any control write.
; The entry caller interprets an out-of-domain host policy as invalid input.

!(import! &self "../../p1/p1.metta")

(= (control_init:program)
   (p1:program control_init
     (Regions (Region controls RW 192 8))
     (Registers (As base v1) (As policy v2) (As ok v3) (As value v4))
     (Init)
     (Seq (Arg0 policy)
          (CmpI Ule ok policy 2)
          (If ok
            (Seq (Base base controls)
                 (Imm value 0) (Store controls base 0 value)
                 (Imm value 1) (Store controls base 8 value)
                 (Imm value 2) (Store controls base 16 value)
                 (Imm value 3) (Store controls base 24 value)
                 (Imm value 4) (Store controls base 32 value)
                 (Imm value 5) (Store controls base 40 value)
                 (Imm value 6) (Store controls base 48 value)
                 (Store controls base 56 policy)
                 (Imm value 0)
                 (Store controls base 64 value)
                 (Store controls base 72 value)
                 (Store controls base 80 value)
                 (Store controls base 88 value)
                 (Store controls base 96 value)
                 (Store controls base 104 value)
                 (Store controls base 112 value)
                 (Store controls base 120 value)
                 (Store controls base 128 value)
                 (Store controls base 136 value)
                 (Store controls base 144 value)
                 (Store controls base 152 value)
                 (Store controls base 160 value)
                 (Store controls base 168 value)
                 (Imm value 14695981039346656037)
                 (Store controls base 176 value)
                 (Imm value 0) (Store controls base 184 value)
                 (Return FIRED policy)))
          (Return REFUSED ok))))

!(let* (($text-path (system:arg 0)) ($notes-path (system:arg 1)) ($proof-path (system:arg 2))
        ($program (p1:the-program control_init:program))
        ($text (p1:write-text $program $text-path))
        ($notes (p1:write-notes $program $notes-path))
        ($proof (fs:write $proof-path
          (p1:cat ("(* Generated by control_init.metta. *)\nlet CONTROL_INIT_TERM = new_definition\n `control_init = "
                   (p1:hol-text $program) "`;;\n")))))
   (Wrote $text-path $notes-path $proof-path))
