; Capture a call request before the driver publishes this leaf's payload.
; The writable request is eight words: seven argument values, then target.
; The target arrives in frame word 17, an otherwise unused region descriptor
; word for this component. No region 8 capability is declared or accessed.
; UNSUPPORTED yields to the procedure controller; it is not a rule refusal.

!(import! &self "../../p1/p1.metta")

(= (procedure_call_marker:program)
   (p1:program procedure_call_marker
     (Regions (Region request RW 64 8))
     (Registers (As arg2 v1) (As arg3 v2) (As arg4 v3) (As arg5 v4) (As arg6 v5)
                (As base v6) (As temp v7) (As target v8))
     (Init (Entry arg2 TyU64) (Entry arg3 TyU64) (Entry arg4 TyU64)
           (Entry arg5 TyU64) (Entry arg6 TyU64))
     (Seq (Base base request)
          (Arg0 temp) (Store request base 0 temp)
          (Arg1 temp) (Store request base 8 temp)
          (Store request base 16 arg2)
          (Store request base 24 arg3)
          (Store request base 32 arg4)
          (Store request base 40 arg5)
          (Store request base 48 arg6)
          (FrameWord TyU64 target 17) (Store request base 56 target)
          (Imm temp 0) (Return UNSUPPORTED temp))))

!(let* (($text-path (system:arg 0)) ($notes-path (system:arg 1)) ($proof-path (system:arg 2))
        ($program (p1:the-program procedure_call_marker:program))
        ($text (p1:write-text $program $text-path))
        ($notes (p1:write-notes $program $notes-path))
        ($proof (fs:write $proof-path
          (p1:cat ("(* Generated by procedure_call.metta. *)\nlet PROCEDURE_CALL_MARKER_TERM = new_definition\n `procedure_call_marker = "
                   (p1:hol-text $program) "`;;\n")))))
   (Wrote $text-path $notes-path $proof-path))
