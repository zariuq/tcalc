(; expect 0 ;)
(; Positive control: rules typed under constraints with no well-founded solution are sound, and fire.
   The left-hand side calc a b (cons b d) (cons a c) is typed under a == f b d and b == f a c, which
   imply a == f (f a c) d: no instance with a normal form satisfies them (the occurs check through
   the static f).  The fixpoint w satisfies them: a := w, b := f w cw, c := cw, d := dw.  So the
   left-hand sides have typable instances, both rules fire on them, and each reduct has its redex's
   type; calc2's right-hand side is typed only by the cyclic consequence a == f (f a c) d.  Dedukti
   stops on these rules (error 207, without --type-lhs; 108 with it). ;)
A : Type.
B : A -> Type.
f : a : A -> B a -> A.
cons : a : A -> b : B a -> B (f a b).

def w : A.
cw : B w.
dw : B (f w cw).
[] w --> f (f w cw) dw.

def calc : a : A -> b : A -> B a -> B b -> Type.
[a, b, c, d] calc a b (cons b d) (cons a c) --> A.

def calc2 : a : A -> b : A -> B a -> B b -> B a.
(; right-hand side : B (f (f a c) d), left-hand side : B a ;)
[a, b, c, d] calc2 a b (cons b d) (cons a c) --> cons (f a c) d.

(; the instances are typable, the rules fire on them, and the reduct has the redex's type ;)
#ASSERT calc w (f w cw) (cons (f w cw) dw) (cons w cw) : Type.
#ASSERT calc w (f w cw) (cons (f w cw) dw) (cons w cw) == A.
#ASSERT calc2 w (f w cw) (cons (f w cw) dw) (cons w cw) : B w.
#ASSERT calc2 w (f w cw) (cons (f w cw) dw) (cons w cw) == cons (f w cw) dw.
#ASSERT cons (f w cw) dw : B w.
