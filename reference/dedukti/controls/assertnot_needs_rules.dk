(; expect 0 ;)
(; A non-convertibility is only evidence for the rules present when it is derived: after the
   second rule, the same pair becomes convertible, and the assertion that follows refers to it. ;)
A : Type.
a : A.
b : A.
def f : A -> A.
[] f a --> a.
#ASSERTNOT f b == b.
[] f b --> b.
#ASSERT f b == b.
