(; A valid file whose assertion compares two differently built copies of the unary numeral
   2^26, successor by successor: more terms than a small memory allowance holds.  Under such
   an allowance the checker has to say that it has no verdict; it may neither refuse the
   file nor die on a signal. ;)

N : Type.
z : N.
s : N -> N.

def dbl : N -> N.
[] dbl z --> z.
[n] dbl (s n) --> s (s (dbl n)).

def pow2 : N -> N.
[] pow2 z --> s z.
[n] pow2 (s n) --> dbl (pow2 n).

def ten : N := s (s (s (s (s (s (s (s (s (s z))))))))).
def plus : N -> N -> N.
[m] plus z m --> m.
[n, m] plus (s n) m --> s (plus n m).

def n24 : N := plus ten (plus ten (s (s (s (s z))))).

#ASSERT pow2 (s (s n24)) == plus (pow2 (s n24)) (pow2 (s n24)).
