(cesta native-c/1 compact-c/2
 (unit
  (include "micromath_leaf.h")
  (ownership (check-all)
    (unchecked (mm_sub1_leaf mm_sub2_leaf)
      (obligation "Given a table whose slot array holds nslot bodies, each leaf reads its premises through bounds-checked references and writes only slot dest, and only when dest < nslot. The machine code of a leaf is the subject of its proof.")))
  (native "
/* Generated by tcalc_compile.metta from the theory file. Do not edit. */

uint64_t mm_sub1_leaf(MmTable *t, uint64_t k0, uint64_t k1, uint64_t k2, uint64_t k3, uint64_t dest) {
    MmBody *sl = t->slot;
    uint64_t n = t->nslot;
    const MmBody *u = &t->unset;
    const MmBody *p0 = k0 < n ? &sl[k0] : u, *p1 = k1 < n ? &sl[k1] : u, *p2 = k2 < n ? &sl[k2] : u, *p3 = k3 < n ? &sl[k3] : u;
    if ((p1->f != p0->x) | (p2->f != p0->y) | (p2->x != p1->x) | (p2->y != p1->y) | (p3->f != p0->out) | (p3->x != p1->x) | (p3->y != p1->y))
        return 0;
    if (dest >= n)
        return 2;
    sl[dest] = (MmBody){p3->out, p0->f, p1->out, p2->out};
    return 1;
}

uint64_t mm_sub2_leaf(MmTable *t, uint64_t k0, uint64_t k1, uint64_t k2, uint64_t k3, uint64_t dest) {
    MmBody *sl = t->slot;
    uint64_t n = t->nslot;
    const MmBody *u = &t->unset;
    const MmBody *p0 = k0 < n ? &sl[k0] : u, *p1 = k1 < n ? &sl[k1] : u, *p2 = k2 < n ? &sl[k2] : u, *p3 = k3 < n ? &sl[k3] : u;
    if ((p1->f != p0->x) | (p2->f != p0->y) | (p2->x != p1->x) | (p2->y != p1->y) | (p3->f != p0->f) | (p3->x != p1->out) | (p3->y != p2->out))
        return 0;
    if (dest >= n)
        return 2;
    sl[dest] = (MmBody){p3->out, p0->out, p1->x, p1->y};
    return 1;
}

")))
