(cesta native-c/1 compact-c/2
 (unit
  (include "micromath_leaf.h")
  (include "stdlib.h")
  (ownership (check-all)
    (unchecked (mm_grow mm_reserve mm_store mm_last_name mm_fresh_name mm_init mm_sub1_fire mm_sub2_fire)
      (obligation "The theorem table and the name counter of the compiled theory: every subscript is below the table size and the table is grown only by grow."))
    (unchecked mm_ref (returns-static)
      (obligation "Returns the body in slot s of the table, or the table's unset body past it; every caller reads it before its next call that can grow the table."))
    (foreign mm_sub1_leaf (obligation "Decides its rule on a table whose slot array holds nslot bodies; writes only slot dest, and only when dest < nslot."))
    (foreign mm_sub2_leaf (obligation "Decides its rule on a table whose slot array holds nslot bodies; writes only slot dest, and only when dest < nslot.")))
  (native "
/* Generated by tcalc_compile.metta from the theory file. Do not edit. */
#define mm_MAX_SLOT ((uint64_t)16777216u)

/* Theorem bodies by slot, stored by value. Unset slots are zero-filled with the unset
   body, which is all zero names (decided when the theory was compiled). */
static MmTable mm_table;
static uint64_t mm_last;

static const MmBody *mm_ref(uint64_t s) {
    return s < mm_table.nslot ? &mm_table.slot[s] : &mm_table.unset;
}

/* Makes slot s writable; false past the slot bound or when the table cannot grow. */
static bool mm_grow(uint64_t s) {
    if (s >= mm_MAX_SLOT)
        return false;
    uint64_t m = mm_table.nslot ? mm_table.nslot : 1024;
    while (m <= s)
        m *= 2;
    MmBody *g = realloc(mm_table.slot, m * sizeof *g);
    if (!g)
        return false;
    for (uint64_t i = mm_table.nslot; i < m; i++)
        g[i] = mm_table.unset;
    mm_table.slot = g;
    mm_table.nslot = m;
    return true;
}

static bool mm_reserve(uint64_t s) { return s < mm_table.nslot || mm_grow(s); }

/* Requires a successful reserve of s. */
static void mm_store(uint64_t s, uint64_t out, uint64_t f, uint64_t x, uint64_t y) {
    mm_table.slot[s] = (MmBody){out, f, x, y};
}

static bool mm_put(uint64_t s, uint64_t out, uint64_t f, uint64_t x, uint64_t y) {
    if (!mm_reserve(s))
        return false;
    mm_store(s, out, f, x, y);
    return true;
}

static uint64_t mm_last_name(void) { return mm_last; }

/* Requires last_name() < UINT64_MAX. */
static uint64_t mm_fresh_name(void) { return ++mm_last; }

bool mm_init(void) {
    free(mm_table.slot);
    mm_table.slot = NULL;
    mm_table.nslot = 0;
    mm_table.unset = (MmBody){0, 0, 0, 0};
    mm_last = 1;
    return true;
}

/* 0 when every name is in use (0 is a declared constant, never minted). */
uint64_t mm_new_opaque(void) { return mm_last_name() == UINT64_MAX ? 0 : mm_fresh_name(); }

/* Trusted: posts a theorem directly; every field must name a name in use. */
bool mm_set(uint64_t out, uint64_t f, uint64_t x, uint64_t y, uint64_t dest) {
    uint64_t last = mm_last_name();
    if (out > last || f > last || x > last || y > last)
        return false;
    return mm_put(dest, out, f, x, y);
}

MmBody mm_get(uint64_t slot) { return *mm_ref(slot); }

bool mm_proj1(uint64_t i0, uint64_t i1, uint64_t dest) {
    return mm_put(dest, i0, 0, i0, i1);
}

bool mm_proj2(uint64_t i0, uint64_t i1, uint64_t dest) {
    return mm_put(dest, i1, 1, i0, i1);
}

bool mm_refl(uint64_t i0, uint64_t dest) {
    return mm_put(dest, i0, i0, 0, 1);
}

static uint64_t mm_sub1_fire(uint64_t k0, uint64_t k1, uint64_t k2, uint64_t k3, uint64_t dest) {
    return mm_sub1_leaf(&mm_table, k0, k1, k2, k3, dest);
}

bool mm_sub1(uint64_t k0, uint64_t k1, uint64_t k2, uint64_t k3, uint64_t dest) {
    uint64_t r = mm_sub1_fire(k0, k1, k2, k3, dest);
    if (r != 2)
        return r == 1;
    if (!mm_grow(dest))
        return false;
    return mm_sub1_fire(k0, k1, k2, k3, dest) == 1;
}

static uint64_t mm_sub2_fire(uint64_t k0, uint64_t k1, uint64_t k2, uint64_t k3, uint64_t dest) {
    return mm_sub2_leaf(&mm_table, k0, k1, k2, k3, dest);
}

bool mm_sub2(uint64_t k0, uint64_t k1, uint64_t k2, uint64_t k3, uint64_t dest) {
    uint64_t r = mm_sub2_fire(k0, k1, k2, k3, dest);
    if (r != 2)
        return r == 1;
    if (!mm_grow(dest))
        return false;
    return mm_sub2_fire(k0, k1, k2, k3, dest) == 1;
}

uint64_t mm_new_def(uint64_t i0, uint64_t i1, uint64_t i2, uint64_t dest) {
    uint64_t last = mm_last_name();
    if (i0 > last || i1 > last || i2 > last || last == UINT64_MAX)
        return 0;
    if (!mm_reserve(dest))
        return 0;
    uint64_t fresh = mm_fresh_name();
    mm_store(dest, fresh, i0, i1, i2);
    return fresh;
}

")))
